@startuml
left to right direction
skinparam usecase {
  BorderColor Black
  BackgroundColor LightYellow
  ArrowColor Black
}
skinparam actor {
  BackgroundColor LightBlue
}

/' Actors '/
actor "Registered User" as User
actor "Admin" as Admin

/' Layer 5: Safety & Moderation '/
package "Safety & Moderation" {
  usecase "Report User" as UC_Report
  usecase "Exclude Reported Users\nfrom feed matching" as UC_Exclude
  usecase "List Reports" as UC_ListReports
  usecase "Review Reports for User" as UC_ReviewUserReports
  usecase "Ban / Unban User" as UC_BanToggle

  UC_Report .> UC_Exclude : <<include>>
  UC_ListReports .> UC_ReviewUserReports : <<include>>
  UC_ReviewUserReports .> UC_BanToggle : <<include>>
}

User --> UC_Report
Admin --> UC_ListReports
Admin --> UC_ReviewUserReports
Admin --> UC_BanToggle
@enduml