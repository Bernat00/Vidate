@startuml
left to right direction
skinparam usecase {
  BorderColor Black
  BackgroundColor LightYellow
  ArrowColor Black
}
skinparam actor {
  BackgroundColor LightBlue
}

/' Actors '/
actor "Registered User" as User

/' Layer 3: Video Dating & Matchmaking '/
package "Realtime Dating & Matchmaking" {
  usecase "Join Feed Queue\n(joined_feed)" as UC_JoinFeed
  usecase "Leave Feed Queue\n(left_feed)" as UC_LeaveFeed
  usecase "Receive Pairing" as UC_ReceivePairing
  usecase "Exchange WebRTC Signals\n(offer/answer/ice_candidate/end_call)" as UC_Signal
  usecase "Start/End Video Date" as UC_VideoDate
  usecase "Submit Feedback\n(like/dislike)" as UC_Feedback

  UC_JoinFeed .> UC_ReceivePairing : <<include>>
  UC_ReceivePairing .> UC_Signal : <<include>>
  UC_Signal .> UC_VideoDate : <<include>>
  UC_VideoDate .> UC_Feedback : <<include>>
}

User --> UC_JoinFeed
User --> UC_LeaveFeed
User --> UC_Feedback

note bottom of UC_VideoDate
  **Video Call Features:**
  - Vertical video stream
  - Maximum 2 minutes duration
  - Either party can end early
  - Both must decide after call ends
end note
@enduml