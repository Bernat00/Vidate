@startuml
left to right direction
skinparam usecase {
  BorderColor Black
  BackgroundColor LightYellow
  ArrowColor Black
}
skinparam actor {
  BackgroundColor LightBlue
}

/' Actors '/
actor "Registered User" as User
actor "Location Service" as LocationService

/' Layer 2: Profile Management '/
package "Profile & Preferences" {
  usecase "Create / Edit Profile" as UC_EditProfile
  usecase "Provide Required Info\n(name, DOB 18+, gender, languages)" as UC_RequiredInfo
  usecase "Provide Optional Info\n(middle name, religion, smoker, wants children)" as UC_OptionalInfo
  usecase "Set Match Preferences\n(age, gender, language, religion, smoker, wants children)" as UC_SetPreferences
  usecase "Share Location in Feed\n(joined_feed lat/lon)" as UC_ShareLocation

  UC_EditProfile .> UC_RequiredInfo : <<include>>
  UC_EditProfile .> UC_OptionalInfo : <<extend>>
}

User --> UC_EditProfile
User --> UC_SetPreferences
User --> UC_ShareLocation

LocationService --> UC_ShareLocation

note right of UC_RequiredInfo
  Profile creation enforces
  age 18+ validation.
end note
@enduml