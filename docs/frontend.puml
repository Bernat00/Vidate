@startuml

skinparam packageStyle rectangle

' ============================
' 1. App Shell + Routing
' ============================

class App <<entrypoint>> {
  +render(): ReactElement
  +provider order: Toast -> Auth -> WebSocket -> Matches
}

class ProtectedRoute <<guard>> {
  +children: ReactNode
  +rules: auth, role redirect, onboarding redirect
}

class PublicOnlyRoute <<guard>> {
  +children: ReactNode
  +rules: redirect authenticated users
}

class ProtectedLayout {
  -isKeyboardOpen: bool
  -isAppPage: bool
  +renders: GradientPage + Navbar + Outlet
}

class MatchesLayout
class NotificationListener


' ============================
' 2. Route Targets
' ============================

class LandingPage
class Login
class Register
class ForgotPassword
class ResetPassword
class SetupProfile
class Home
class MyMatches
class MatchProfile
class ProfilePage
class AdminDashboard <<admin>>

App --> LandingPage : "/"
App --> Login : "/login"
App --> Register : "/register"
App --> ForgotPassword : "/forgot-password"
App --> ResetPassword : "/reset-password"
App --> SetupProfile : "/setup-profile"
App --> Home : "/home"
App --> MyMatches : "/my-matches"
App --> MatchProfile : "/my-matches/profile/:userId"
App --> ProfilePage : "/profile"
App --> AdminDashboard : "/admin" (admin)

App --> PublicOnlyRoute
App --> ProtectedRoute
ProtectedRoute --> ProtectedLayout
ProtectedLayout --> MatchesLayout
App *-- NotificationListener


' ============================
' 3. Context Contracts
' ============================

package "Context Providers" {
  class AuthProvider {
    +user: UserMe?
    +loading: bool
    +refresh(): Promise<void>
  }

  class MatchesProvider {
    +matches: MatchItem[]
    +loading: bool
    +refreshMatches(): Promise<void>
  }

  class ToastProvider {
    +showToast(message: str, status?: ToastStatus): void
  }

  class WebSocketProvider {
    +subscribe(type: str, handler): unsubscribe
    +send(message: WebSocketMessage): void
    -connect()/reconnect()
  }
}

App *-- ToastProvider
App *-- AuthProvider
App *-- WebSocketProvider
App *-- MatchesProvider
ProtectedRoute ..> AuthProvider
PublicOnlyRoute ..> AuthProvider
MatchesProvider ..> AuthProvider
NotificationListener ..> WebSocketProvider


' ============================
' 4. Integration Boundaries
' ============================

package "Integrations" {
  class "api (frontend/src/api.ts)" as api <<integration>> {
    +baseURL = window.origin + /api
    +request interceptor: Bearer token
    +response interceptor: 401/403 handling
  }

  class "getWsUrl/wsUrl (webSocketContext.tsx)" as ws_url <<integration>> {
    +url: /ws/main?token=...
    +events: match_found, match_confirmed, chat_message, offer/answer/ice/end_call
    +keepalive: ping
  }
}

AuthProvider ..> api : GET /users/me
MatchesProvider ..> api : GET /matches/mine
WebSocketProvider ..> ws_url
WebSocketProvider ..> api : token source


' ============================
' 5. Component Taxonomy
' ============================

package auth {
  class AuthCardLayout
  class AuthHeader
}

package chat {
  class MessageList
}

package common {
  class DeleteConfirmationModal
  class EmptyState
  class Icon
  class InfoItem
  class ListItem
  class Modal
  class NavButton
  class Toggle
}

package form {
  class DestructiveButton
  class FormAlert
  class FormErrorText
  class FormField
  class PrimaryButton
  class RHFCheckbox
  class RHFTextInput
}

package landing {
  class DeviceMockup
  class FeatureButton
  class Hero
}

package layout {
  class CenteredLoader
  class ChatColumn
  class DashboardLayout
  class GradientPage
  class MobileTopBar
  class Section
  class SidebarOverlay
}

package profile {
  class DemographicFields
  class NameFields
}

package shared {
  class ChatInput
  class DateField
  class MessageBubble
  class Navbar
  class PermissionRequest
  class SelectField
  class Sidebar
  class TextField
  class Toast
}

LandingPage *-- Hero
LandingPage *-- DeviceMockup
LandingPage *-- FeatureButton
MyMatches *-- MessageList

@enduml
