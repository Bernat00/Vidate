@startuml

' ============================
' 1. App Shell + Routing
' ============================

class App {
  +render(): ReactElement
  -wrapProviders(): JSX
}

class ProtectedRoute {
  +children: ReactNode
  +enforceAuth(): JSX
  +enforceRoleAndOnboarding(): JSX
}

class PublicOnlyRoute {
  +children: ReactNode
  +redirectIfAuthenticated(): JSX
}

class ProtectedLayout {
  -isKeyboardOpen: bool
  -isAppPage: bool
  +render(): JSX
}

class LandingPage
class LoginPage
class RegisterPage
class SetupProfilePage
class HomePage
class MyMatchesPage
class MatchProfilePage
class ProfilePage
class ForgotPasswordPage
class ResetPasswordPage
class AdminDashboardPage <<admin>>

App --> LandingPage : "/"
App --> LoginPage : "/login"
App --> RegisterPage : "/register"
App --> ForgotPasswordPage : "/forgot-password"
App --> ResetPasswordPage : "/reset-password"
App --> SetupProfilePage : "/setup-profile"
App --> HomePage : "/home"
App --> MyMatchesPage : "/my-matches"
App --> MatchProfilePage : "/my-matches/profile/:userId"
App --> ProfilePage : "/profile"
App --> AdminDashboardPage : "/admin" (admin)

App --> ProtectedRoute
App --> PublicOnlyRoute
ProtectedRoute --> ProtectedLayout


' ============================
' 2. Context Contracts
' ============================

class AuthContext {
  +user: UserMe?
  +loading: bool
  +refresh(): Promise<void>
}

class MatchesContext {
  +matches: MatchItem[]
  +loading: bool
  +refreshMatches(): Promise<void>
}

class ToastContext {
  +showToast(message: str, status?: ToastStatus): void
}

class WebSocketContext {
  +subscribe(type: str, handler): unsubscribe
  +send(message: WebSocketMessage): void
  -connect(): void
}

App *-- ToastContext
App *-- AuthContext
App *-- WebSocketContext
App *-- MatchesContext
ProtectedRoute ..> AuthContext
PublicOnlyRoute ..> AuthContext


' ============================
' 3. Integration Boundaries
' ============================

class ApiClient {
  +baseURL: str
  +requestAuthInterceptor(): config
  +responseAuthInterceptor(): response
}

class NotificationListener {
  +listenMatchConfirmed(): void
  +listenBanEvent(): void
}

class MatchesLayout
class MessageList

AuthContext ..> ApiClient : GET /users/me
MatchesContext ..> ApiClient : GET /matches/mine
WebSocketContext ..> ApiClient : token source
App *-- NotificationListener
MatchesLayout *-- MessageList


