@startuml
left to right direction
skinparam usecase {
  BorderColor Black
  BackgroundColor LightYellow
  ArrowColor Black
}
skinparam actor {
  BackgroundColor LightBlue
}

/' Actors '/
actor "Registered User" as User

/' Layer 4: Matches & Communication '/
package "Matches & Communication" {
  usecase "Confirm Match\n(mutual likes)" as UC_ConfirmMatch
  usecase "View My Matches" as UC_ViewMatches
  usecase "View Match Profile" as UC_ViewMatchProfile
  usecase "Load Match Event History" as UC_LoadEvents
  usecase "Send/Receive Chat Message" as UC_Chat

  UC_ConfirmMatch .> UC_ViewMatches : <<include>>
  UC_ViewMatches .> UC_ViewMatchProfile : <<include>>
  UC_ViewMatches .> UC_LoadEvents : <<include>>
  UC_ViewMatches .> UC_Chat : <<include>>
}

User --> UC_ViewMatches
User --> UC_Chat
@enduml